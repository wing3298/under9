{
    "defaultSeverity": "error",
    "extends": [
        "tslint:recommended"
    ],
    "jsRules": {},
    "rules": {
        "no-consecutive-blank-lines": [
            false
            ],
        "no-unused-expression": [
            true,
            "allow-new"
        ],
        "ordered-imports": [
            false
        ],
        "quotemark": [
            true,
            "single"
        ],
        "indent": [
            true
        ],
        "interface-name": [
            false
        ],
        "arrow-parens": false,
        // Pending fix for shorthand property names.
        "object-literal-sort-keys": false
    },
    "rulesDirectory": []
}