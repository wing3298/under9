{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "noImplicitAny": false,
    "target": "esnext",
    "module": "esnext",
    "lib": ["DOM", "esnext"],
    "jsx": "preserve",
    "sourceMap": true,
    "strict": true,
    "moduleResolution": "node",
    "allowJs": true,
    "esModuleInterop": true,
    "baseUrl": "./",
    "suppressImplicitAnyIndexErrors": true,
    "typeRoots": [
      "types",
      "node_modules/@types"
    ],
    "types": [
      "@types/node",
  ]
  },
  "include": [
    "src/**/*",
    "types/**/*"
  ],
  "exclude": [
    "node_modules",
    "**/*.spec.ts",
    ".nuxt",
    "dist"
  ],
  "files": ["src/main.ts"]
}
